#include "cache.h"

#define IP_TRACKER_COUNT 24
#define PREFETCH_DEGREE 3
#define MASK_IP 0xFF
#define STRIDE_ARRAY_SIZE 16
#define MAX_CONFIDENCE 3

class IP_TRACKER {
public:
  bool valid;
  uint8_t ip;
  uint64_t last_cl_addr;

  int64_t stride_array[STRIDE_ARRAY_SIZE];
  int64_t last_stride;
  int8_t confidence;
  int8_t non_uniform_confidence;
  int16_t num_iterations;
  int8_t curr_index;
  int8_t size;

  uint32_t lru;

  IP_TRACKER() {
    valid = false;
    ip = 0;
    last_cl_addr = 0;
    for (int i = 0; i < STRIDE_ARRAY_SIZE; i++) {
      stride_array[i] = 0;
    }
    last_stride = 0;
    confidence = 0;
    non_uniform_confidence = 0;
    num_iterations = 0;
    curr_index = 0;
    size = 0;
    lru = 0;
  };
};

IP_TRACKER trackers[IP_TRACKER_COUNT];
uint64_t last_resolved_prefetches = 0;
uint64_t last_useful_prefetches = 0;
uint8_t accuracy_degree_limit = 6;

void CACHE::l1d_prefetcher_initialize() {
  std::cout << "------------------------------------------------" << std::endl;
  std::cout << "        Stride Pattern Prefetcher (SPP)         " << std::endl;
  std::cout << "------------------------------------------------" << std::endl;

  for (int8_t i = 0; i < IP_TRACKER_COUNT; i++)
    trackers[i].lru = i;
}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip,
                                   uint8_t cache_hit, uint8_t type,
                                   uint8_t critical_ip_flag) {
  uint64_t cl_addr = addr >> LOG2_BLOCK_SIZE;

  ip = ip & MASK_IP;

  int8_t index = -1;
  for (index = 0; index < IP_TRACKER_COUNT; index++) {
    if (trackers[index].valid && trackers[index].ip == ip)
      break;
  }

  if (index == IP_TRACKER_COUNT) {
    for (index = 0; index < IP_TRACKER_COUNT; index++) {
      if (trackers[index].lru == (IP_TRACKER_COUNT - 1))
        break;
    }

    trackers[index].ip = ip;
    trackers[index].last_cl_addr = cl_addr;

    for (int i = 0; i < IP_TRACKER_COUNT; i++) {
      if (trackers[i].lru < trackers[index].lru)
        trackers[i].lru++;
    }

    trackers[index].valid = true;
    trackers[index].lru = 0;
    trackers[index].size = 0;
    trackers[index].curr_index = 0;
    trackers[index].num_iterations = 0;
    trackers[index].last_stride = 0;
    trackers[index].confidence = 0;
    trackers[index].non_uniform_confidence = 0;
    return;
  }

  if (index == -1)
    assert(0);

  int64_t stride = 0;
  if (cl_addr > trackers[index].last_cl_addr) {
    stride = cl_addr - trackers[index].last_cl_addr;
  } else {
    stride = trackers[index].last_cl_addr - cl_addr;
    stride *= -1;
  }

  if (stride == 0)
    return;

  auto &curr_index = trackers[index].curr_index;
  auto &num_iterations = trackers[index].num_iterations;
  auto &size = trackers[index].size;
  auto &pattern = trackers[index].stride_array;

  auto &tracker = trackers[index];

  const uint64_t resolved = pf_useful + pf_useless;
  if (resolved < last_resolved_prefetches || pf_useful < last_useful_prefetches) {
    last_resolved_prefetches = resolved;
    last_useful_prefetches = pf_useful;
  }
  if (resolved - last_resolved_prefetches >= 128) {
    const double accuracy =
        double(pf_useful - last_useful_prefetches) /
        (resolved - last_resolved_prefetches);
    if (accuracy < 0.25 && accuracy_degree_limit > PREFETCH_DEGREE)
      --accuracy_degree_limit;
    else if (accuracy > 0.50 && accuracy_degree_limit < PREFETCH_DEGREE + MAX_CONFIDENCE)
      ++accuracy_degree_limit;
    last_resolved_prefetches = resolved;
    last_useful_prefetches = pf_useful;
  }

  if (stride == tracker.last_stride) {
    if (tracker.confidence < MAX_CONFIDENCE)
      ++tracker.confidence;
  } else {
    tracker.confidence = 0;
  }
  tracker.last_stride = stride;

  const bool pattern_matches = size > 0 && stride == pattern[curr_index];
  if (pattern_matches) {
    if (tracker.non_uniform_confidence < MAX_CONFIDENCE)
      ++tracker.non_uniform_confidence;
  } else {
    tracker.non_uniform_confidence = 0;
  }

  if (tracker.confidence >= 1) {
    const int degree = min<int>(PREFETCH_DEGREE + tracker.confidence,
                                accuracy_degree_limit);
    for (int i = 0; i < degree; i++) {
      uint64_t pf_address = (cl_addr + (stride * (i + 1))) << LOG2_BLOCK_SIZE;

      if ((pf_address >> LOG2_PAGE_SIZE) != (addr >> LOG2_PAGE_SIZE))
        break;

      if (MSHR.occupancy < (MSHR.SIZE >> 1))
        prefetch_line(ip, addr, pf_address, FILL_L1, 0);
      else
        prefetch_line(ip, addr, pf_address, FILL_L2, 0);
    }
  }
  if (pattern_matches) {
    const int degree = min<int>(PREFETCH_DEGREE + tracker.non_uniform_confidence,
                                accuracy_degree_limit);
    uint64_t prefetch_stride_index = (curr_index + 1) % size;
    uint64_t pf_address_prefix = cl_addr;

    for (int i = 0; i < degree; i++) {
      pf_address_prefix += pattern[prefetch_stride_index];
      uint64_t pf_address = pf_address_prefix << LOG2_BLOCK_SIZE;

      if ((pf_address >> LOG2_PAGE_SIZE) != (addr >> LOG2_PAGE_SIZE))
        break;

      if (MSHR.occupancy < (MSHR.SIZE >> 1))
        prefetch_line(ip, addr, pf_address, FILL_L1, 0);
      else
        prefetch_line(ip, addr, pf_address, FILL_L2, 0);

      prefetch_stride_index = (prefetch_stride_index + 1) % size;
    }
  }

  trackers[index].last_cl_addr = cl_addr;
  if (size == 0) {
    size = 1;
    pattern[0] = stride;
    curr_index = 0;
    num_iterations = 0;
  } else {
    if (stride != pattern[curr_index]) {
      if (num_iterations == 0) {
        if (size == STRIDE_ARRAY_SIZE) {
          size = 1;
          pattern[0] = stride;
          curr_index = 0;
          num_iterations = 0;
        } else {
          pattern[size++] = stride;
        }
      } else {
        const int64_t completed = num_iterations - (curr_index != 0 ? 1 : 0);
        const int64_t required = size + completed * size + curr_index + 1;

        if (required > STRIDE_ARRAY_SIZE) {
          size = 1;
          pattern[0] = stride;
          curr_index = 0;
          num_iterations = 0;
        } else {
          int64_t expansion_index = size;
          for (int64_t i = 0; i < completed; i++) {
            for (int j = 0; j < size; j++) {
              pattern[expansion_index++] = pattern[j];
            }
          }
          for (int j = 0; j < curr_index; j++) {
            pattern[expansion_index++] = pattern[j];
          }
          pattern[expansion_index++] = stride;
          size = expansion_index;
          curr_index = 0;
          num_iterations = 0;
        }
      }
    } else {
      if (curr_index == 0 && num_iterations < STRIDE_ARRAY_SIZE) {
        num_iterations++;
      }
      curr_index = (curr_index + 1) % size;
    }
  }

  for (int i = 0; i < IP_TRACKER_COUNT; i++) {
    if (trackers[i].lru < trackers[index].lru)
      trackers[i].lru++;
  }
  trackers[index].lru = 0;
  return;
}

void CACHE::l1d_prefetcher_cache_fill(uint64_t v_addr, uint64_t addr,
                                      uint32_t set, uint32_t way,
                                      uint8_t prefetch, uint64_t v_evicted_addr,
                                      uint64_t evicted_addr,
                                      uint32_t metadata_in) {
  return; // metadata_in;
}

void CACHE::l1d_prefetcher_final_stats() {
  cout << "CPU" << cpu << " L1D SPP final stats" << endl;
  cout << "Degree budget: " << PREFETCH_DEGREE << " + predictor confidence (0-"
       << MAX_CONFIDENCE << "), accuracy limit: " << int(accuracy_degree_limit)
       << endl;
}
