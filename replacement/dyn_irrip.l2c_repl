#include "cache.h"
#include <iostream>

#define maxRRPV 3
uint32_t l2_rrpv[L2C_SET][L2C_WAY];

#define NUM_LEADERS 16
#define LEADER_STRIDE (L2C_SET / NUM_LEADERS)
#define DECISION_INTERVAL 4096
#define INSTR_THRESH 0.35

static inline bool is_leader(uint32_t set) { 
    return (set % LEADER_STRIDE == 0);
}

static uint64_t leader_instr_acc = 0;
static uint64_t leader_instr_miss = 0;
static uint64_t leader_total_acc = 0;
static uint64_t leader_total_miss = 0;
static uint64_t since_decision = 0;

static bool use_irrip = false;
static uint64_t total_intervals = 0;
static uint64_t irrip_intervals = 0;

static inline void update_ratio(uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    if (type == WRITEBACK)
        return;

    leader_total_acc++;
    since_decision++;
    if (!hit) leader_total_miss++;
    if (isInstruction) {
        leader_instr_acc++;
        if (!hit) leader_instr_miss++;
    }

    if (since_decision >= DECISION_INTERVAL) {
        double ratio = (double)(leader_instr_acc + leader_instr_miss) / (leader_total_acc + leader_total_miss);
        bool next = (ratio > INSTR_THRESH);
        use_irrip = next;

        total_intervals++;
        if (use_irrip) irrip_intervals++;

        // multiply the counters by 0.9 to give less weight to history
        leader_instr_acc = (uint64_t)(leader_instr_acc * 0.9);
        leader_instr_miss = (uint64_t)(leader_instr_miss * 0.9);
        leader_total_acc = (uint64_t)(leader_total_acc * 0.9);
        leader_total_miss = (uint64_t)(leader_total_miss * 0.9);

        since_decision = 0; // so that a change happens every DECISION_INTERVAL cycles as intended
    }
}

static inline uint32_t find_victim_irrip(CACHE* cache, uint32_t set)
{
    while (1)
    {
        int instr_victim = -1;

        for (int i=0; i<L2C_WAY; i++){
            if (l2_rrpv[set][i] == maxRRPV){
                if (cache->block[set][i].instruction) {
                    if (instr_victim < 0) instr_victim = i;
                }
                else {
                    return i; // this is a data victim, preferrably get rid of it
                }
            }
        }
        if (instr_victim >= 0) return instr_victim;
            
        for (int i=0; i<L2C_WAY; i++)
            l2_rrpv[set][i]++;
    }

    // WE SHOULD NOT REACH HERE
    assert(0);
    return 0;
}

static inline uint32_t find_victim_rrip(uint32_t set)
{
    while (1)
    {
        for (int i=0; i<L2C_WAY; i++)
            if (l2_rrpv[set][i] == maxRRPV)
                return i;

        for (int i=0; i<L2C_WAY; i++)
            l2_rrpv[set][i]++;
    }
}

static inline void update_replacement_state_irrip(uint32_t set, uint32_t way, uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    if (hit){
        if (isInstruction){
            l2_rrpv[set][way] = 0;
        }
        else if (type != WRITEBACK && type != PREFETCH && l2_rrpv[set][way] > 0) {
            l2_rrpv[set][way]--; // for data, gradually promote it, but don't promote writeback hits, because they don't signal reuse really
        }
    }
    else{
        if (isInstruction){
            l2_rrpv[set][way] = maxRRPV - 1; 
        }
        else {
            l2_rrpv[set][way] = maxRRPV;  
        }
    }
}

static inline void update_replacement_state_rrip(uint32_t set, uint32_t way, uint32_t type, uint8_t hit)
{
    if (hit) {
        if (type != WRITEBACK && type != PREFETCH)
            l2_rrpv[set][way] = 0;
    }
    else {
          if (type == WRITEBACK || type == PREFETCH)
              l2_rrpv[set][way] = maxRRPV; // only data is written back, and this is slightly deprioritizing data more
          else
              l2_rrpv[set][way] = maxRRPV - 1;  //insert with RRPV2
    }
}

void CACHE::l2c_initialize_replacement()
{
    cout << "Initialize dynamic iRRIP state for L2C" << endl;

    for (int i=0; i<L2C_SET; i++) {
        for (int j=0; j<L2C_WAY; j++) {
            l2_rrpv[i][j] = maxRRPV;
        }
    }
}

uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    if (is_leader(set) || !use_irrip)
        return find_victim_rrip(set);
    return find_victim_irrip(this, set);
}

void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    if (is_leader(set)) {
        update_ratio(type, hit, isInstruction);
        update_replacement_state_rrip(set, way, type, hit);
    } 
    else if (use_irrip) {
        update_replacement_state_irrip(set, way, type, hit, isInstruction);
    } 
    else {
        update_replacement_state_rrip(set, way, type, hit);
    }
}

void CACHE::l2c_replacement_final_stats()
{

}
